PORT=5001

# Set to 1 when nginx sits in front (production). Leave unset for local dev.
# TRUST_PROXY=1

# Lock this down in production — don't leave it as *
CORS_ORIGIN=https://musicblocks.sugarlabs.org

# GitHub credentials
GITHUB_PAT=
GITHUB_USERNAME=
ORG_NAME=musicblocks-planet

# GitHub App
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=

# Path to the GitHub App private key (.pem) file.
# In Docker: mount the file and point here.
# In local dev: leave unset → defaults to dist/config/private-key.pem
GITHUB_APP_PRIVATE_KEY_PATH=/etc/musicblocks/private-key.pem

# Path to the SQLite database file.
# In Docker: this should be inside a named volume.
SQLITE_PATH=/var/lib/musicblocks/projects.sqlite
